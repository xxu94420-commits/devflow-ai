DATABASE_URL=sqlite:///./data/devflow.db
COMPOSE_DATABASE_URL=sqlite:////data/devflow.db
# PostgreSQL: postgresql+psycopg://devflow:password@postgres:5432/devflow
GITHUB_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Optional write protection. Set this before exposing API beyond localhost.
DEVFLOW_API_KEY=
# Hard read-only boundary, including valid-key requests. Local default is false.
READ_ONLY=false
# Public Docker image defaults to READ_ONLY=true; no local database is uploaded.
DEMO_IMPORT_GITHUB=false
# 0 disables background Actions polling; otherwise >=300. Public demo uses 3600.
CI_SYNC_INTERVAL_SECONDS=0
# JUnit downloads require GITHUB_TOKEN with Actions:read for this repository.
VITE_API_URL=http://localhost:8000

# Requirement review: credentials stay on the server; choose an available model.
REVIEW_API_BASE_URL=https://api.groq.com/openai/v1
REVIEW_MODEL=openai/gpt-oss-20b
REVIEW_API_KEY=
# Optional local Ollama; Docker Desktop uses http://host.docker.internal:11434/v1
REVIEW_OLLAMA_ENABLED=false
REVIEW_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
REVIEW_OLLAMA_MODEL=
# Explicit exception to read-only: stateless POST /api/review/trial only.
PUBLIC_REVIEW_ENABLED=false
# Single-process daily guard, reset on restart; not a monetary spending limit.
PUBLIC_REVIEW_DAILY_LIMIT=20
